# ── LINE Bot credentials (from Day 1) ──────────────
LINE_CHANNEL_SECRET=paste_your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=paste_your_channel_access_token_here

# ── Gemini API (Day 2) ────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_gemini_api_key_here

# ── Google Sheets (Day 2) ─────────────────────────
# The Sheet ID is the long string in your sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=paste_your_sheet_id_here

# Path to your service account key file (downloaded from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# The tab/worksheet name (default: Sheet1). Change if yours is different.
# GOOGLE_SHEET_TAB=Sheet1